# Root .dockerignore — used by every image built with `context: .`
# (docker/frontend/Dockerfile[.dev], docker/php/Dockerfile).
node_modules/
**/node_modules/
.next/
**/.next/
.turbo/
**/.turbo/
.git/
*.log
npm-debug.log*

# PHP/Laravel (kept OUT of the frontend images via each Dockerfile's own
# COPY list, not blanket-excluded here — docker/php/Dockerfile needs apps/backend/)
**/vendor/
**/storage/framework/cache/data/
**/storage/framework/sessions/
**/storage/framework/views/
**/storage/logs/
**/bootstrap/cache/*.php

# OS / IDE
.DS_Store
.idea/
.vscode/
